<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <GenerateGitProperties Condition="'$(GenerateGitProperties)' == ''">auto</GenerateGitProperties>
    <GitPropertiesWriteToProjectDirectory Condition="'$(GitPropertiesWriteToProjectDirectory)' == ''">false</GitPropertiesWriteToProjectDirectory>
    <GitPropertiesFallbackFile Condition="'$(GitPropertiesFallbackFile)' == ''">$(MSBuildProjectDirectory)\git.properties</GitPropertiesFallbackFile>
    <GitPropertiesEnableWarnings Condition="'$(GitPropertiesEnableWarnings)' == ''">true</GitPropertiesEnableWarnings>
    <GitPropertiesConsumingPackageIds Condition="'$(GitPropertiesConsumingPackageIds)' == ''">Steeltoe.Management.Endpoint</GitPropertiesConsumingPackageIds>
    <GitExecutable Condition="'$(GitExecutable)' == ''">git</GitExecutable>
    <GitCommitIdAbbrevLength Condition="'$(GitCommitIdAbbrevLength)' == ''">7</GitCommitIdAbbrevLength>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(GitPropertiesFallbackFile)')">
    <!-- Outside any Target, so this is evaluated early enough to hide the fallback file from Solution Explorer. -->
    <None Remove="$(GitPropertiesFallbackFile)" />
  </ItemGroup>

  <!--
    General note: Tasks don't run when DesignTimeBuild is true, to prevent shelling out to git on every keystroke.
  -->

  <PropertyGroup>
    <!--
      Building from source repeatedly recompiles this assembly, so tasks load out-of-process via TaskHostFactory below (slower) to avoid locking it against a
      rebuild; a NuGet consumer never rebuilds it, so tasks load in-process instead, which is faster.
    -->
    <GitPropertiesTasksTfm Condition="'$(GitPropertiesTasksTfm)' == ''">netstandard2.0</GitPropertiesTasksTfm>
    <GitPropertiesTasksAssembly>$(MSBuildThisFileDirectory)..\bin\tasks\$(GitPropertiesTasksTfm)\Steeltoe.Management.GitProperties.Build.dll</GitPropertiesTasksAssembly>
    <GitPropertiesUseTaskHostFactory Condition="'$(GitPropertiesUseTaskHostFactory)' == '' and Exists('$(MSBuildThisFileDirectory)..\SourceCheckout.txt')">true</GitPropertiesUseTaskHostFactory>
    <GitPropertiesUseTaskHostFactory Condition="'$(GitPropertiesUseTaskHostFactory)' == ''">false</GitPropertiesUseTaskHostFactory>
  </PropertyGroup>

  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' == 'true'" TaskName="FindGitRepositoryRootTask" AssemblyFile="$(GitPropertiesTasksAssembly)"
    TaskFactory="TaskHostFactory" />
  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' == 'true'" TaskName="DetectConsumingPackageReferenceTask"
    AssemblyFile="$(GitPropertiesTasksAssembly)" TaskFactory="TaskHostFactory" />
  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' == 'true'" TaskName="GenerateGitPropertiesCacheTask" AssemblyFile="$(GitPropertiesTasksAssembly)"
    TaskFactory="TaskHostFactory" />
  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' == 'true'" TaskName="ComposeGitPropertiesTask" AssemblyFile="$(GitPropertiesTasksAssembly)"
    TaskFactory="TaskHostFactory" />
  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' == 'true'" TaskName="ReportGitDiagnosticTask" AssemblyFile="$(GitPropertiesTasksAssembly)"
    TaskFactory="TaskHostFactory" />

  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' != 'true'" TaskName="FindGitRepositoryRootTask" AssemblyFile="$(GitPropertiesTasksAssembly)" />
  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' != 'true'" TaskName="DetectConsumingPackageReferenceTask"
    AssemblyFile="$(GitPropertiesTasksAssembly)" />
  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' != 'true'" TaskName="GenerateGitPropertiesCacheTask" AssemblyFile="$(GitPropertiesTasksAssembly)" />
  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' != 'true'" TaskName="ComposeGitPropertiesTask" AssemblyFile="$(GitPropertiesTasksAssembly)" />
  <UsingTask Condition="'$(GitPropertiesUseTaskHostFactory)' != 'true'" TaskName="ReportGitDiagnosticTask" AssemblyFile="$(GitPropertiesTasksAssembly)" />

  <!--
    Hooked directly to every relevant BeforeTargets value, not via DependsOnTargets, because a target's own Condition is evaluated before its
    DependsOnTargets run. So nothing that reads $(GitRepositoryRoot)/$(_GitPropertiesShouldGenerate) could rely on a DependsOnTargets chain to set them first.
    DependsOnTargets="ResolveProjectReferences": needed when this package is consumed via ProjectReference rather than an installed package, so the task
    assembly exists on disk before these hooks fire.
  -->
  <Target Name="ResolveGitPropertiesPaths" BeforeTargets="BeforeBuild;AssignTargetPaths;CoreCompile;PrepareForPublish"
    DependsOnTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <GitPropertiesFile Condition="'$(GitPropertiesFile)' == ''">$(IntermediateOutputPath)git.properties</GitPropertiesFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GenerateGitProperties)' != 'auto'">
      <_GitPropertiesShouldGenerate>$(GenerateGitProperties)</_GitPropertiesShouldGenerate>
    </PropertyGroup>

    <DetectConsumingPackageReferenceTask PackageIds="$(GitPropertiesConsumingPackageIds)" ProjectAssetsFile="$(ProjectAssetsFile)"
      Condition="'$(GenerateGitProperties)' == 'auto'">
      <Output TaskParameter="HasReference" PropertyName="_GitPropertiesShouldGenerate" />
    </DetectConsumingPackageReferenceTask>

    <Message Condition="'$(GenerateGitProperties)' == 'auto' and '$(_GitPropertiesShouldGenerate)' != 'true'"
      Text="git.properties generation skipped: no reference to '$(GitPropertiesConsumingPackageIds)' found in this project's resolved dependency graph. Set GenerateGitProperties=true to generate it anyway." />

    <FindGitRepositoryRootTask StartDirectory="$(MSBuildProjectDirectory)" Condition="'$(GitRepositoryRoot)' == ''">
      <Output TaskParameter="RepositoryRoot" PropertyName="GitRepositoryRoot" />
      <Output TaskParameter="IsUnsupportedGitFile" PropertyName="_GitPropertiesUnsupportedGitFile" />
    </FindGitRepositoryRootTask>

    <PropertyGroup Condition="'$(GitRepositoryRoot)' != ''">
      <GitPropertiesCacheDirectory Condition="'$(GitPropertiesCacheDirectory)' == ''">$(GitRepositoryRoot)obj\_GitProperties\</GitPropertiesCacheDirectory>
      <GitPropertiesCacheFile Condition="'$(GitPropertiesCacheFile)' == ''">$(GitPropertiesCacheDirectory)git.properties.cache</GitPropertiesCacheFile>
    </PropertyGroup>

    <ReportGitDiagnosticTask DiagnosticId="1" EnableWarnings="$(GitPropertiesEnableWarnings)"
      Condition="'$(GitRepositoryRoot)' == '' and '$(_GitPropertiesUnsupportedGitFile)' != 'true' and '$(_GitPropertiesShouldGenerate)' == 'true' and !Exists('$(GitPropertiesFallbackFile)')"
      Message="git.properties generation skipped: no usable .git directory found above '$(MSBuildProjectDirectory)'." />

    <ReportGitDiagnosticTask DiagnosticId="2" EnableWarnings="$(GitPropertiesEnableWarnings)"
      Condition="'$(_GitPropertiesUnsupportedGitFile)' == 'true' and '$(_GitPropertiesShouldGenerate)' == 'true' and !Exists('$(GitPropertiesFallbackFile)')"
      Message="git.properties generation skipped: '$(MSBuildProjectDirectory)' resolves to a git worktree or submodule (a '.git' file, not a directory), which this feature does not support." />

    <Message Condition="'$(GitRepositoryRoot)' == '' and '$(_GitPropertiesShouldGenerate)' == 'true' and Exists('$(GitPropertiesFallbackFile)')"
      Text="git.properties: live generation skipped; using pre-generated fallback file '$(GitPropertiesFallbackFile)' instead." />

    <ItemGroup Condition="'$(GitRepositoryRoot)' != ''">
      <!--
        A literal Inputs path that doesn't exist forces a full rebuild every time rather than being excluded, unlike a glob, so some entries are only
        added when present.
        .git\config is included because git.remote.origin.url and the committer identity fields come from git config output.
        .git\index is deliberately excluded: the live "git status" call made on every build for the dirty check can itself rewrite it, which would
        otherwise force an unnecessary regeneration on the very next build.
      -->
      <_GitPropertiesCacheInputs Include="$(GitRepositoryRoot).git\HEAD" Condition="Exists('$(GitRepositoryRoot).git\HEAD')" />
      <_GitPropertiesCacheInputs Include="$(GitRepositoryRoot).git\config" Condition="Exists('$(GitRepositoryRoot).git\config')" />
      <_GitPropertiesCacheInputs Include="$(GitRepositoryRoot).git\packed-refs" Condition="Exists('$(GitRepositoryRoot).git\packed-refs')" />
      <_GitPropertiesCacheInputs Include="$(GitRepositoryRoot).git\refs\heads\**\*" />
      <_GitPropertiesCacheInputs Include="$(GitRepositoryRoot).git\refs\tags\**\*" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateGitPropertiesCache" BeforeTargets="BeforeBuild;AssignTargetPaths" DependsOnTargets="ResolveGitPropertiesPaths"
    Condition="'$(_GitPropertiesShouldGenerate)' == 'true' and '$(TargetFramework)' != '' and '$(DesignTimeBuild)' != 'true'"
    Inputs="@(_GitPropertiesCacheInputs)" Outputs="$(GitPropertiesCacheFile)">
    <GenerateGitPropertiesCacheTask Condition="'$(GitRepositoryRoot)' != ''" RepositoryRoot="$(GitRepositoryRoot)" GitExecutable="$(GitExecutable)"
      CacheFile="$(GitPropertiesCacheFile)" CommitIdAbbrevLength="$(GitCommitIdAbbrevLength)" EnableWarnings="$(GitPropertiesEnableWarnings)" />
  </Target>

  <!--
    Registers the Content item before AssignTargetPaths converts it into what the copy-to-output/publish targets use. PrepareForPublish is kept as a
    safety net for a no-build publish, which runs AssignTargetPaths before PrepareForPublish rather than after.
    The two ItemGroups below are mutually exclusive: the fallback file is only used when there's no live-generated cache, so both never map to the same
    "git.properties" Link at once.
  -->
  <Target Name="IncludeGitPropertiesInOutput" BeforeTargets="BeforeBuild;AssignTargetPaths;PrepareForPublish" DependsOnTargets="GenerateGitPropertiesCache"
    Condition="'$(_GitPropertiesShouldGenerate)' == 'true' and '$(_GitPropertiesIncluded)' != 'true' and (Exists('$(GitPropertiesCacheFile)') or Exists('$(GitPropertiesFallbackFile)'))">
    <ItemGroup Condition="Exists('$(GitPropertiesCacheFile)')">
      <Content Include="$(GitPropertiesFile)" Link="git.properties" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="$(GitPropertiesFile)" />
    </ItemGroup>

    <!--
      Deliberately not added to FileWrites: this file lives in the project directory, not $(IntermediateOutputPath), so `dotnet clean` never touches it.
      Don't add it "for consistency", that would delete the one durable copy a git-less build depends on.
    -->
    <ItemGroup Condition="!Exists('$(GitPropertiesCacheFile)') and Exists('$(GitPropertiesFallbackFile)')">
      <Content Include="$(GitPropertiesFallbackFile)" Link="git.properties" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup>
      <_GitPropertiesIncluded>true</_GitPropertiesIncluded>
    </PropertyGroup>
  </Target>

  <!--
    BeforeTargets="CoreCompile", not "BeforeBuild", so $(Version) is final even when a versioning tool (Nerdbank.GitVersioning/GitVersion/MinVer)
    computes it later in the pipeline.
  -->
  <Target Name="ComposeGitProperties" BeforeTargets="CoreCompile;PrepareForPublish" DependsOnTargets="GenerateGitPropertiesCache"
    Condition="'$(_GitPropertiesShouldGenerate)' == 'true' and Exists('$(GitPropertiesCacheFile)') and '$(DesignTimeBuild)' != 'true' and '$(_GitPropertiesComposed)' != 'true'">
    <PropertyGroup>
      <_GitPropertiesFallbackFileTarget Condition="'$(GitPropertiesWriteToProjectDirectory)' == 'true'">$(GitPropertiesFallbackFile)</_GitPropertiesFallbackFileTarget>
    </PropertyGroup>

    <ComposeGitPropertiesTask RepositoryRoot="$(GitRepositoryRoot)" GitExecutable="$(GitExecutable)" CacheFile="$(GitPropertiesCacheFile)"
      OutputFile="$(GitPropertiesFile)" Version="$(Version)" FallbackFile="$(_GitPropertiesFallbackFileTarget)" EnableWarnings="$(GitPropertiesEnableWarnings)" />

    <Message Importance="High" Text="git.properties: writing to '$([System.IO.Path]::GetFullPath('$(GitPropertiesFile)'))'." />
    <Message Importance="High" Condition="'$(_GitPropertiesFallbackFileTarget)' != ''"
      Text="git.properties: writing fallback copy to '$([System.IO.Path]::GetFullPath('$(_GitPropertiesFallbackFileTarget)'))'." />

    <PropertyGroup>
      <_GitPropertiesComposed>true</_GitPropertiesComposed>
    </PropertyGroup>
  </Target>

  <!--
    Refreshes just the fallback file without a full build. Intended for source-based `cf push`. Runs a nested <MSBuild> re-invocation reaching
    "AssignTargetPaths;PrepareForPublish" rather than depending on or invoking ComposeGitProperties directly, because that target's own Condition depends
    on $(GitPropertiesCacheFile), which is set only by its own DependsOnTargets chain. That chain has not run yet when the Condition is checked (the same
    rule noted on ResolveGitPropertiesPaths above). The nested build reaches the SDK's own injection points instead, without ever reaching CoreCompile.
  -->
  <Target Name="WriteGitPropertiesFallbackFile">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="AssignTargetPaths;PrepareForPublish"
      Properties="Configuration=$(Configuration);GenerateGitProperties=true;GitPropertiesWriteToProjectDirectory=true" />
  </Target>

</Project>
